# ── Servidor ──
NODE_ENV=development
PORT=4000

# ── Base de datos (PostgreSQL) ──
DATABASE_URL=postgresql://peter:peter@localhost:5432/peter_solution

# ── Seguridad ──
JWT_SECRET=cambiar-este-secreto
JWT_EXPIRES_IN=8h

# ── Credenciales admin (placeholder, se reemplazará por auth real) ──
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# ── CORS (orígenes permitidos, separados por coma) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Logging ──
LOG_LEVEL=info
